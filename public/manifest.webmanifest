{
  "name": "CoolerCo Field",
  "short_name": "CoolerCo",
  "description": "Scan assets, follow your trip and see case status — works with weak or no signal.",
  "id": "/field",
  "start_url": "/field",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F5F7FA",
  "theme_color": "#1A2340",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Scan", "url": "/field/scan", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My trip", "url": "/field/trip", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
